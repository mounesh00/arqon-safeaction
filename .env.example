# Names/placeholders only. Launcher configures these securely without .env files.
ARQON_DATABASE_PATH=/absolute/path/to/private/demo.db
ARQON_BACKEND_URL=http://127.0.0.1:8100
ARQON_OPERATOR_ORIGIN=http://127.0.0.1:3210
ARQON_OPERATOR_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_BACKEND_CREDENTIAL
ARQON_OPERATOR_LOGIN_HASH=scrypt:REPLACE_WITH_SALT:REPLACE_WITH_VERIFIER
# Optional absolute paths to your existing isolated interpreters:
ARQON_BACKEND_PYTHON=/absolute/path/to/.venv-backend/bin/python
ARQON_MCP_PYTHON=/absolute/path/to/.venv-mcp/bin/python
NEXT_TELEMETRY_DISABLED=1
